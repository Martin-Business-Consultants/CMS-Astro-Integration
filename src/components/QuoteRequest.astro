---
/**
 * "Request a quote" (the CMS's Commerce plugin), posting straight to the CMS: name, email, phone,
 * company, a message, and the items asked about (hidden). With JavaScript it
 * submits in place; data-state is idle, sending, sent or failed. Unstyled:
 * classes are cms-quote__*.
 */
import { HONEYPOT, quoteRequestAction, type QuoteItem } from "@librepublish/astro/commerce";

interface Props {
  items?: QuoteItem[];
  submitLabel?: string;
  /** Default: the shop's own (Settings › Commerce), then "Thanks — we'll be in touch with a quote." */
  successMessage?: string;
  class?: string;
}

const { items = [], submitLabel = "Request a quote", successMessage, class: className } = Astro.props;
const action = await quoteRequestAction();
if (!action) throw new Error("<QuoteRequest>: the CMS doesn't have Commerce switched on (Settings › Plugins).");
const fields = [
  { name: "customer_name", label: "Name", type: "text", required: true, autocomplete: "name" },
  { name: "customer_email", label: "Email", type: "email", required: true, autocomplete: "email" },
  { name: "customer_phone", label: "Phone", type: "tel", required: false, autocomplete: "tel" },
  { name: "company", label: "Company", type: "text", required: false, autocomplete: "organization" },
];
---
<form class:list={["cms-quote", className]} action={action} method="post" data-cms-quote data-state="idle" data-success={successMessage}>
  {fields.map((field) => (
    <div class="cms-quote__field">
      <label for={`quote-${field.name}`}>{field.label}{field.required && <span aria-hidden="true"> *</span>}</label>
      <input id={`quote-${field.name}`} type={field.type} name={field.name} required={field.required} autocomplete={field.autocomplete} />
      <p class="cms-quote__error" data-error-for={field.name} data-label={field.label} hidden></p>
    </div>
  ))}
  <div class="cms-quote__field">
    <label for="quote-message">What do you need?</label>
    <textarea id="quote-message" name="message" rows="4"></textarea>
  </div>
  {items.map((item, index) => Object.entries(item).map(([key, value]) => (
    <input type="hidden" name={`items[${index}][${key}]`} value={String(value)} />
  )))}
  <input type="hidden" name="page_url" value={Astro.url.href} />
  <div aria-hidden="true" style="position:absolute;left:-9999px">
    <label>Leave this empty <input type="text" name={HONEYPOT} tabindex="-1" autocomplete="off" /></label>
  </div>
  <button type="submit" class="cms-quote__submit">{submitLabel}</button>
  <p class="cms-quote__status" role="status" aria-live="polite"></p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-cms-quote]")) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>(".cms-quote__status")!;
      form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((el) => { el.hidden = true; el.textContent = ""; });
      form.dataset.state = "sending";
      status.textContent = "Sending…";
      try {
        const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
        const body = await response.json().catch(() => ({}));
        if (response.ok) {
          form.dataset.state = "sent";
          form.reset();
          status.textContent = form.dataset.success || body.success_message || "Thanks — we'll be in touch with a quote.";
          return;
        }
        form.dataset.state = "failed";
        for (const [name, messages] of Object.entries(body.errors ?? {})) {
          const el = form.querySelector<HTMLElement>(`[data-error-for="${CSS.escape(name)}"]`);
          // The CMS says "can't be blank"; the field's label makes it a sentence.
          if (el) { el.textContent = ([] as string[]).concat(messages as string[]).map((message) => `${el.dataset.label ?? name} ${message}.`).join(" "); el.hidden = false; }
        }
        // What isn't one field's ("an email address or a phone number is required").
        const general = ([] as string[]).concat((body.errors?.base as string[] | undefined) ?? []);
        status.textContent = body.error === "rate_limited" ? "Too many tries — please wait a few minutes."
          : general.length ? general.map((message) => message[0].toUpperCase() + message.slice(1) + ".").join(" ")
          : "Please check the highlighted fields.";
      } catch {
        form.dataset.state = "failed";
        status.textContent = "Couldn't send — check your connection and try again.";
      }
    });
  }
</script>
